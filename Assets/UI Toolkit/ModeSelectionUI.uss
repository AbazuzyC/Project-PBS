/* Screen root container */
.screen-root {
    width: 100%;
    height: 100%;
    justify-content: center;
    align-items: center;
    background-color: transparent; /* Overlay over main scene background */
    flex-direction: column;
}

/* Page Title style */
.title-text {
    color: #FFFFFF;
    font-size: 44px;
    -unity-font: url('project://database/Assets/Baloo-Regular.ttf');
    -unity-font-definition: url('project://database/Assets/Baloo-Regular SDF.asset');
    -unity-font-style: bold;
    -unity-text-align: middle-center;
    margin-top: 15px;
    margin-bottom: 25px;
}

/* Horizontal alignment of the three cards */
.cards-row {
    flex-direction: row;
    justify-content: center;
    align-items: center;
    width: 100%;
}

/* The card container */
.mode-card {
    width: 380px;
    height: 440px;
    background-color: #FEECD3; /* Cream background FEECD3 */
    border-radius: 30px; /* Corner radius 30 */
    border-width: 4px;
    border-color: #FFFFFF; /* Sleek white border */
    margin-left: 25px;
    margin-right: 25px;
    padding-left: 20px;
    padding-right: 20px;
    padding-top: 50px;
    padding-bottom: 50px;
    align-items: center;
    justify-content: center;
    position: relative;
    flex-grow: 0;
    flex-shrink: 0;
}

/* Overlapping wooden header banner using Base_Header.png */
.card-wood-header {
    position: absolute;
    top: -30px;
    width: 240px;
    height: 62px;
    background-image: url('project://database/Assets/Sprites/Base_Header.png');
    background-size: stretch;
    background-color: rgba(0, 0, 0, 0);
    color: #FFFFFF;
    font-size: 24px;
    -unity-font: url('project://database/Assets/Baloo-Regular.ttf');
    -unity-font-definition: url('project://database/Assets/Baloo-Regular SDF.asset');
    -unity-font-style: bold;
    -unity-text-align: middle-center;
    padding-bottom: 6px; /* Adjust text position vertically on wood board */
}

/* Image preview simulating a phone screen */
.mode-image-preview {
    width: 280px;
    height: 160px;
    border-radius: 20px; /* Phone rounded corners */
    border-width: 6px;
    border-color: #1A1A1A; /* Black bezel frame for phone style */
    background-size: cover;
    background-position: center;
    background-repeat: no-repeat;
    overflow: hidden;
    margin-bottom: 10px;
}

/* Assign generated image placeholders */
.ar-preview {
    background-image: url('project://database/Assets/Sprites/ar_mode_placeholder.png');
}

.quiz-preview {
    background-image: url('project://database/Assets/Sprites/quiz_mode_placeholder.png');
}

.materi-preview {
    background-image: url('project://database/Assets/Sprites/materi_mode_placeholder.png');
}

/* Overlapping wooden buttons using Base_Button.png */
Button.card-wood-btn {
    position: absolute;
    bottom: -30px;
    width: 200px;
    height: 60px;
    background-image: url('project://database/Assets/Sprites/Base_Button.png');
    background-size: stretch;
    background-color: rgba(0, 0, 0, 0); /* Use rgba for transparency instead of keyword */
    -unity-background-image-tint-color: rgb(255, 255, 255); /* Fully white to display the texture */
    border-left-width: 0px;
    border-right-width: 0px;
    border-top-width: 0px;
    border-bottom-width: 0px;
    border-color: rgba(0, 0, 0, 0);
    color: #FFFFFF;
    font-size: 24px;
    -unity-font: url('project://database/Assets/Baloo-Regular.ttf');
    -unity-font-definition: url('project://database/Assets/Baloo-Regular SDF.asset');
    -unity-font-style: bold;
    -unity-text-align: middle-center;
    padding-bottom: 6px; /* Adjust text position vertically on wood button */
    transition: scale 0.1s ease;
}

Button.card-wood-btn:hover {
    scale: 1.05;
    background-image: url('project://database/Assets/Sprites/Base_Button.png');
    background-color: rgba(0, 0, 0, 0);
    -unity-background-image-tint-color: rgb(255, 255, 255);
}

Button.card-wood-btn:active {
    scale: 0.95;
    background-image: url('project://database/Assets/Sprites/Base_Button.png');
    background-color: rgba(0, 0, 0, 0);
    -unity-background-image-tint-color: rgb(255, 255, 255);
}

Button.card-wood-btn:focus {
    background-color: rgba(0, 0, 0, 0);
    -unity-background-image-tint-color: rgb(255, 255, 255);
}
