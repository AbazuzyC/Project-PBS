  m_Name: Tahap 3 - Kepompong
  m_EditorClassIdentifier: Assembly-CSharp::TopicCategorySO
  topicName: 'TAHAP 3: KEPOMPONG (PUPA)'
  pages:
  - pageTitle: 'Tahap 3: Rumah Kepompong'
    contentText: "Ulat menganyam bantalan benang sutra, lalu menggantung terbalik membentuk <b>posisi huruf \"J\"</b>.\n\nUlat melepas kulit lamanya untuk terakhir kali dan membentuk cangkang pelindung keras yang disebut <b>chrysalis</b>."
    pageImage: {fileID: 0}
  - pageTitle: 'Tahap 3: Keajaiban Perubahan'
    contentText: "Di balik cangkang chrysalis, terjadi proses <b>histolisis</b> (peleburan jaringan larva) dan <b>histogenesis</b> (perakitan organ dewasa).\n\nProses perombakan menakjubkan ini berlangsung sekitar <b>1 hingga 2 minggu</b>."
    pageImage: {fileID: 0}
