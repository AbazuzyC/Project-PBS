  m_Name: Tahap 2 - Ulat
  m_EditorClassIdentifier: Assembly-CSharp::TopicCategorySO
  topicName: 'TAHAP 2: ULAT (LARVA)'
  pages:
  - pageTitle: 'Tahap 2: Si Pemakan Daun'
    contentText: "Setelah telur menetas, keluarlah ulat atau larva.\n\nUlat memiliki nafsu makan yang sangat besar! Mereka memakan dedaunan hijau di sekitarnya tanpa henti siang dan malam agar tubuhnya cepat besar."
    pageImage: {fileID: 0}
  - pageTitle: 'Tahap 2: Berganti Kulit'
    contentText: "Karena tubuhnya membesar dengan sangat cepat, ulat akan berganti kulit (molting) sebanyak 4 hingga 5 kali.\n\nSetelah tubuhnya cukup besar dan gemuk, ulat akan mencari tempat aman untuk beristirahat."
    pageImage: {fileID: 0}
