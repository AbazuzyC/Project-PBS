  m_Name: Tahap 2 - Ulat
  m_EditorClassIdentifier: Assembly-CSharp::TopicCategorySO
  topicName: 'TAHAP 2: ULAT (LARVA)'
  pages:
  - pageTitle: 'Tahap 2: Si Pemakan Daun'
    contentText: "Setelah menetas, ulat langsung memakan sisa cangkang telurnya sendiri.\n\nFase ini dijuluki <b>\"Mesin Makan\"</b> karena ulat terus melahap dedaunan hijau siang dan malam tanpa henti untuk mengumpulkan nutrisi pertumbuhan."
    pageImage: {fileID: 0}
  - pageTitle: 'Tahap 2: Berganti Kulit'
    contentText: "Karena kulit luarnya tidak elastis, ulat harus berganti kulit (<b>molting</b>) sebanyak <b>4 hingga 5 kali</b>.\n\nFase pertumbuhan ulat ini memakan waktu sekitar <b>2 hingga 4 minggu</b> sebelum ulat siap beristirahat."
    pageImage: {fileID: 0}
